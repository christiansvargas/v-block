{
  "manifest_version": 3,
  "name": "v-block",
  "version": "0.2.0",
  "icons": {
    "128": "assets/logo.png"
  },
  "minimum_chrome_version": "111",
  "description": "Lightweight YouTube ad filtering with experimental video-ad skipping.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "v-block",
    "default_popup": "popup/index.html",
    "default_icon": "assets/logo.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "rules/rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/player.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}